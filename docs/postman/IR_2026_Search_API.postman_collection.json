        {
          "name": "Search — Custom BM25 Parameters",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataset\": \"{{dataset}}\",\n  \"query\": \"Should teachers get tenure?\",\n  \"execution_mode\": \"basic\",\n  \"retrieval_mode\": \"bm25\",\n  \"bm25_k1\": 2.0,\n  \"bm25_b\": 0.6,\n  \"top_k\": 10,\n  \"include_snippet_chars\": 500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search"]
