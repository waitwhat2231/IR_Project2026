              "raw": "{\n  \"dataset\": \"{{dataset}}\",\n  \"query\": \"artificial intelligence ethics\",\n  \"execution_mode\": \"basic\",\n  \"retrieval_mode\": \"word2vec\",\n  \"top_k\": 5\n}",
