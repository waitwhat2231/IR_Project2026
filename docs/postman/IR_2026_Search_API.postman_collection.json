      ]
    },
    {
      "name": "Query Refinement",
      "item": [
        {
          "name": "Query Suggestions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/suggestions?q=should&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "suggestions"],
              "query": [
                {
                  "key": "q",
                  "value": "should",
                  "description": "Partial query prefix for autocomplete"
                },
                {
                  "key": "limit",
                  "value": "5",
                  "description": "Max suggestions (1–20)"
                }
              ]
            },
            "description": "Autocomplete suggestions from search history (Requirement 5). Run an enhanced search first to populate history."
          },
          "response": []
